# ChargeFlow - Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration (optional - app works in demo mode without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Routing API (optional - uses free OSRM by default)
ROUTING_API_KEY=

# Geocoding API (optional - uses free Nominatim by default)
GEOCODING_API_KEY=

# EV Station Data API (optional - uses demo data by default)
EV_STATION_API_KEY=
